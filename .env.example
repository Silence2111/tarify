# PostgreSQL. Самый быстрый способ без локальной установки — бесплатный Postgres на Neon (neon.tech)
# или Supabase. Скопируй этот файл в .env и подставь строку подключения.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# DIRECT_URL — прямое подключение для миграций/db push (на Neon: строка БЕЗ -pooler).
# Локально и на не-serverless БД можно указать то же, что DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Локальный Postgres (если установлен):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tarify?schema=public"

# DaData — адресный слой (ФИАС/ГАР) для автокомплита улиц по всей РФ.
# Необязательно: без ключа автокомплит берёт улицы из локальной базы (seed).
# Бесплатный ключ: https://dadata.ru/api/suggest/address/ (нужен только "API-ключ").
# DADATA_API_KEY="your_dadata_api_key"

# Админка (/admin/*). В проде обе переменные обязательны — без них админка не откроется.
# В dev без них пароль "admin".
ADMIN_PASSWORD="change-me"
ADMIN_SECRET="change-this-too"

# Постбэк CPA-сетей (/api/postback): секрет в адресе постбэка. Без него приём выключен.
# Сгенерировать: openssl rand -hex 24
# POSTBACK_TOKEN="длинная-случайная-строка"

# Передача заявок в CPA-сеть или CRM сразу после отправки формы (см. DEPLOY.md, п. 6).
# Поля подставляются в фигурных скобках: {name}, {phone_digits}, {subid} и др.
# LEAD_WEBHOOK_URL="https://сеть/api/lead?token=...&phone={phone_digits}&subid={subid}"

# Telegram: уведомления оператору о заявках (без персональных данных).
# TELEGRAM_BOT_TOKEN="123456:ABC..."
# TELEGRAM_LEADS_CHAT_ID="123456789"
# Канал, куда бот публикует изменения цен после загрузки прайса (бот — админ канала).
# TELEGRAM_CHANNEL_ID="@tarify_ceny"

# Реквизиты оператора персональных данных и получатели заявок — в согласие и политику.
# OPERATOR_NAME="ООО «Тарифы»"
# OPERATOR_INN="1650000000"
# OPERATOR_OGRN="1231600000000"
# OPERATOR_ADDRESS="420000, Казань, ул. …"
# OPERATOR_EMAIL="pd@ваш-домен.ру"
# PD_RECIPIENTS="ООО «Пампаду» (Pampadu), ООО «Адмитад» (Admitad)"

# Базовый URL сайта — для канонических ссылок, sitemap.xml и robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Демо-плашка «данные примерные». Выставьте 0, когда зальёте реальное покрытие.
NEXT_PUBLIC_DEMO="1"

# Rate-limit на serverless (несколько инстансов): Upstash Redis (REST).
# Без них лимитер работает in-memory (ок для одного инстанса/локалки).
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxx"

# Аналитика Plausible (privacy-friendly, без cookie-баннера). Необязательно.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="ваш-домен.ру"

# Яндекс Метрика: номер счётчика. Цели lead (заявка) и partner_click («Оформить»)
# отправляются сами — в Метрике их нужно создать как JavaScript-события (см. DEPLOY.md).
# NEXT_PUBLIC_YANDEX_METRIKA_ID="12345678"
