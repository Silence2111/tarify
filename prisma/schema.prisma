// Модель данных MVP-агрегатора тарифов.
// Ядро: «тариф» (Provider -> Plan -> PlanOption) + адресный слой (City/Street/Building)
// + матрица покрытия (Coverage) + воронка денег (Lead).
// Ядро «тариф» переиспользуется при пивоте в B2B-конструктор тарифов.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // рантайм: pooled-строка (Neon -pooler)
  directUrl = env("DIRECT_URL") // миграции/db push: прямое подключение
}

enum ServiceType {
  INTERNET
  TV
  MOBILE           // каталог мобильной связи: без покрытия, цены по регионам
  BUNDLE
  BUSINESS_ACCOUNT // расчётный счёт для бизнеса (РКО) — раздел «Для бизнеса»
}

// Статус конверсии из постбэка CPA-сети.
enum ConversionStatus {
  PENDING  // сеть получила действие, решения нет
  HOLD     // подтверждено, ждёт выплаты (холд)
  APPROVED // оплачено — это деньги
  REJECTED // отклонено
}

enum LeadStatus {
  NEW       // заявка пришла
  CALLED    // дозвонились / в работе
  CONFIRMED // подтверждённое подключение (за это платит провайдер)
  REJECTED  // отвал (нет техвозможности / отказ / недозвон)
}

model Provider {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  logoUrl   String?
  phone     String?
  // CPA-ставка, которую провайдер платит за подтверждённое подключение, ₽.
  // Хранится для расчёта потенциального дохода с заявки.
  payoutRub Int?
  isActive  Boolean    @default(true)
  plans     Plan[]
  coverage  Coverage[]
  clicks    Click[]
  createdAt DateTime   @default(now())
}

model Plan {
  id           String       @id @default(cuid())
  provider     Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId   String
  name         String
  type         ServiceType  @default(INTERNET)
  speedMbps    Int?
  priceMonthly Int // ₽/мес, базовая цена
  priceFirst   Int? // акция на первый месяц, ₽
  hasTv        Boolean      @default(false)
  tvChannels   Int?
  hasMobile    Boolean      @default(false)
  mobileGb     Int? // ГБ мобильного интернета; -1 — безлимит
  minutes      Int? // минут в месяц; -1 — безлимит
  sms          Int? // SMS в месяц; -1 — безлимит
  esim         Boolean      @default(false)
  // Регион цены (как City.region). Тарифы мобильной связи в каждом регионе стоят
  // по-своему; null — цена одна для всей России (и все тарифы домашнего интернета).
  region       String?
  // Партнёрская ссылка CPA-сети: кнопка «Оформить» ведёт на сайт оператора вместо
  // заявки с обзвоном. erid — токен маркировки рекламы от сети (ФЗ «О рекламе»).
  url          String?
  erid         String?
  description  String?
  options      PlanOption[]
  leads        Lead[]
  clicks       Click[]
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  // Свежесть цены: повторная загрузка прайса обновляет. Каталоги показывают
  // «Цены обновлены …» — у конкурентов цены висят месяцами без даты.
  updatedAt    DateTime     @default(now()) @updatedAt

  @@index([providerId])
  @@index([type, region])
}

// Гибкие опции тарифа (роутер в аренду, статический IP, антивирус и т.п.)
model PlanOption {
  id     String @id @default(cuid())
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId String
  label  String
  value  String

  @@index([planId])
}

model City {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  region  String?
  streets Street[]
}

model Street {
  id        String     @id @default(cuid())
  city      City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  cityId    String
  slug      String
  name      String
  buildings Building[]

  @@unique([cityId, slug])
  @@index([cityId])
}

model Building {
  id       String     @id @default(cuid())
  street   Street     @relation(fields: [streetId], references: [id], onDelete: Cascade)
  streetId String
  house    String
  fiasGuid String? // привязка к ФИАС/ГАР для будущей интеграции с DaData
  coverage Coverage[]
  leads    Lead[]

  @@unique([streetId, house])
  @@index([streetId])
}

// Ключевая сущность: какой провайдер обслуживает конкретный дом.
// Готового API по РФ нет — эту матрицу мы строим и поддерживаем сами.
model Coverage {
  id         String   @id @default(cuid())
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String
  techNote   String? // GPON / FTTB / ADSL ...
  source     String? // из какого фида пришла запись (для атрибуции)
  updatedAt  DateTime @updatedAt @default(now()) // свежесть: главная боль — держать покрытие актуальным

  @@unique([buildingId, providerId])
  @@index([providerId])
}

// Переход по партнёрской ссылке («Оформить»). id уходит в CPA-сеть меткой {subid},
// постбэк сети возвращает её со статусом конверсии и суммой. Так видно, какие
// операторы и тарифы приносят деньги без заявки с обзвоном.
model Click {
  id         String            @id @default(cuid())
  plan       Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId     String?
  provider   Provider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String
  page       String? // откуда перешли: путь страницы сайта
  status     ConversionStatus? // null — от сети пока ничего не пришло
  statusRaw  String? // статус как его прислала сеть — на случай незнакомого слова
  payoutRub  Int? // сумма из постбэка, ₽
  network    String?
  statusAt   DateTime?
  createdAt  DateTime          @default(now())

  @@index([providerId, createdAt])
  @@index([createdAt])
}

// Воронка денег: заявка на подключение.
model Lead {
  id          String     @id @default(cuid())
  name        String
  phone       String
  company     String? // заявка «интернет в офис» из раздела «Для бизнеса»
  addressText String
  building    Building?  @relation(fields: [buildingId], references: [id])
  buildingId  String?
  plan        Plan?      @relation(fields: [planId], references: [id])
  planId      String?
  status      LeadStatus @default(NEW)
  comment     String?
  consent     Boolean    @default(false) // согласие на обработку ПДн (152-ФЗ)
  createdAt   DateTime   @default(now())

  @@index([status])
  @@index([createdAt])
}
